{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "stdio": { "type": "stdio", "command": "./bin/server", "args": ["--state", "${PLUGIN_DATA}/state"], "cwd": "${PLUGIN_ROOT}" },
    "http": { "type": "streamable-http", "url": "https://api.example.test/mcp", "headers": { "X-Tenant": "public" } },
    "sse": { "type": "sse", "url": "http://localhost:3000/sse" }
  }
}
